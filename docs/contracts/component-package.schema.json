{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edward Component Package Manifest",
  "type": "object",
  "required": ["resourceId", "displayName", "target", "assets"],
  "properties": {
    "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "target": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,127}$" },
    "pluginId": { "type": "string", "minLength": 1 },
    "pluginVersion": { "type": "string", "minLength": 1 },
    "thumbnail": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).*$" },
    "fusionComp": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^/].*\\.comp$" },
    "fusionUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "fusionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fusionResolveVersion": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
