{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edward Component Package Manifest",
  "type": "object",
  "required": ["resourceId", "displayName", "runtimeManifest", "props", "assets", "preview"],
  "properties": {
    "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "runtimeManifest": { "type": "string", "const": "edward-runtime.json" },
    "props": { "type": "string", "const": "props.json" },
    "preview": { "type": "string", "const": "preview.mp4" },
    "thumbnail": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).*$" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "mimeType", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$" },
          "mimeType": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
