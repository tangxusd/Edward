{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": 1,
  "source": "docs/operation-log/2026-08-10-001-requirement-audit.md#85-87",
  "defaultPreset": "jianying-compatible",
  "platformRule": {
    "macos": "Command and Option use the confirmed macOS keys.",
    "windows": "Command maps to Ctrl, Option maps to Alt, Shift and non-modifier keys are preserved."
  },
  "focusPolicy": {
    "timelineOnly": true,
    "passThrough": ["text-editor", "numeric-editor", "editable-table"],
    "conflictRule": "A Windows system conflict must be shown as editable in shortcut settings; it must not silently change behavior."
  },
  "bindings": [
    { "action": "timeline.select-tool", "macos": "A", "windows": "A" },
    { "action": "timeline.blade-tool", "macos": "B", "windows": "B" },
    { "action": "timeline.split", "macos": "Cmd+B", "windows": "Ctrl+B" },
    { "action": "timeline.batch-split", "macos": "Cmd+Shift+B", "windows": "Ctrl+Shift+B" },
    { "action": "timeline.select-left", "macos": "[", "windows": "[" },
    { "action": "timeline.select-right", "macos": "]", "windows": "]" },
    { "action": "timeline.primary-track-snap", "macos": "P", "windows": "P" },
    { "action": "timeline.snap-toggle", "macos": "N", "windows": "N" },
    { "action": "timeline.linkage-toggle", "macos": "~", "windows": "~" },
    { "action": "timeline.preview-axis-toggle", "macos": "S", "windows": "S" },
    { "action": "timeline.track-zoom-in", "macos": "Cmd+Plus", "windows": "Ctrl+Plus" },
    { "action": "timeline.track-zoom-out", "macos": "Cmd+Minus", "windows": "Ctrl+Minus" },
    { "action": "timeline.trim-right", "macos": "W", "windows": "W" },
    { "action": "timeline.trim-left", "macos": "Q", "windows": "Q" },
    { "action": "timeline.clip-enabled-toggle", "macos": "V", "windows": "V" },
    { "action": "timeline.add-marker", "macos": "M", "windows": "M" },
    { "action": "timeline.add-color-marker", "macos": "Option+M", "windows": "Alt+M" },
    { "action": "timeline.next-marker", "macos": "Shift+M", "windows": "Shift+M" },
    { "action": "timeline.previous-marker", "macos": "Option+Shift+M", "windows": "Alt+Shift+M" },
    { "action": "playback.previous-frame", "macos": "Left", "windows": "Left" },
    { "action": "playback.next-frame", "macos": "Right", "windows": "Right" },
    { "action": "playback.first-frame", "macos": "Home", "windows": "Home" },
    { "action": "playback.last-frame", "macos": "End", "windows": "End" },
    { "action": "timeline.previous-edit", "macos": "Up", "windows": "Up" },
    { "action": "timeline.next-edit", "macos": "Down", "windows": "Down" },
    { "action": "timeline.set-in", "macos": "I", "windows": "I" },
    { "action": "timeline.set-out", "macos": "O", "windows": "O" },
    { "action": "timeline.select-range-after", "macos": "Shift+X", "windows": "Shift+X" },
    { "action": "timeline.clear-range-selection", "macos": "Option+X", "windows": "Alt+X" },
    { "action": "timeline.group", "macos": "Cmd+G", "windows": "Ctrl+G" },
    { "action": "timeline.ungroup", "macos": "Cmd+Shift+G", "windows": "Ctrl+Shift+G" },
    { "action": "timeline.speed-panel", "macos": "Cmd+R", "windows": "Ctrl+R" },
    { "action": "timeline.custom-curve-speed", "macos": "Shift+B", "windows": "Shift+B" },
    { "action": "timeline.create-compound-clip", "macos": "Option+G", "windows": "Alt+G" },
    { "action": "timeline.break-compound-clip", "macos": "Option+Shift+G", "windows": "Alt+Shift+G" },
    { "action": "audio.volume-up-point-one-db", "macos": "Cmd+Period", "windows": "Ctrl+Period" },
    { "action": "audio.volume-down-point-one-db", "macos": "Cmd+Comma", "windows": "Ctrl+Comma" },
    { "action": "timeline.use-in-out-range", "macos": "Shift+Enter", "windows": "Shift+Enter" },
    { "action": "playback.reverse", "macos": "J", "windows": "J" },
    { "action": "playback.stop", "macos": "K", "windows": "K" },
    { "action": "playback.forward", "macos": "L", "windows": "L" },
    { "action": "timeline.track-height-increase", "macos": "Cmd+Option+Plus", "windows": "Ctrl+Alt+Plus" },
    { "action": "timeline.track-height-decrease", "macos": "Cmd+Option+Minus", "windows": "Ctrl+Alt+Minus" }
  ],
  "unboundConfirmedFeatures": [
    "freeze-frame", "reverse-clip", "mirror", "rotate", "crop", "reselect-range",
    "recognize-captions-or-lyrics", "vocal-separation-actions", "audio-video-align",
    "smart-vlog-cut", "smart-extend", "smart-rough-cut", "reveal-in-file-manager",
    "link-media", "replace-clip", "export-selected-range", "live-photo", "clear-beats",
    "record-audio", "fill-text-gap", "keyframe-panel-toggle", "add-keyframe"
  ],
  "unboundPolicy": "These features are implemented through the confirmed UI/menu flows. No keyboard binding is introduced until a key is verified; implementation must not invent one."
}
