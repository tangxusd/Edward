{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edward Animation Plugin RPC",
  "type": "object",
  "required": ["jsonrpc", "id", "method", "params"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1},
    "method": {"enum": ["describe", "renderFrame", "renderExport"]},
    "params": {"type": "object"}
  },
  "$defs": {
    "renderExportParams": {
      "type": "object",
      "required": ["compositionId", "outputPath", "width", "height", "frameCount", "fpsNumerator", "fpsDenominator"],
      "properties": {
        "compositionId": {"type": "string", "minLength": 1},
        "outputPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frameCount": {"type": "integer", "minimum": 1},
        "fpsNumerator": {"type": "integer", "minimum": 1},
        "fpsDenominator": {"type": "integer", "minimum": 1}
      }
    },
    "renderExportResult": {
      "type": "object",
      "required": ["outputPath", "width", "height", "frameCount", "hasAlpha"],
      "properties": {
        "outputPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frameCount": {"type": "integer", "minimum": 1},
        "hasAlpha": {"type": "boolean"}
      }
    }
  }
}
