{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edward.app/contracts/runtime-host.v1.schema.json",
  "title": "Edward Web Runtime Host manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "runtime",
    "width",
    "height",
    "fps",
    "durationInFrames",
    "previewEntry",
    "renderEntry",
    "propsSchema",
    "editableProperties",
    "editableTracks",
    "capabilities"
  ],
  "properties": {
    "protocol": { "const": "edward.web-runtime.v1" },
    "runtime": { "enum": ["react", "html-css", "svg", "gsap"] },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "durationInFrames": { "type": "integer", "minimum": 1 },
    "previewEntry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.?(?:[/\\\\]|$))[^:]+$"
    },
    "renderEntry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.?(?:[/\\\\]|$))[^:]+$"
    },
    "propsSchema": { "type": "object" },
    "editableProperties": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "editableTracks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "export", "editable", "audio", "transparent"],
      "properties": {
        "preview": { "const": true },
        "export": { "const": true },
        "editable": { "type": "boolean" },
        "audio": { "type": "boolean" },
        "transparent": { "type": "boolean" }
      }
    }
  }
}
