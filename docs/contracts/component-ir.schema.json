{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edward Component IR",
  "type": "object",
  "required": ["version", "root"],
  "properties": {
    "version": { "const": "1" },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["container", "text", "shape", "image", "svg"] },
        "properties": { "type": "object" },
        "transform": {
          "type": "object",
          "description": "x/y are center-origin Edward coordinates: left/up positive, right/down negative.",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          }
        },
        "keyframes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["frame", "value"],
              "properties": {
                "frame": { "type": "integer", "minimum": 0 },
                "value": { "type": "number" },
                "easing": { "enum": ["linear", "bezier"] },
                "controlIn": { "type": "number" },
                "controlOut": { "type": "number" }
              }
            }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
